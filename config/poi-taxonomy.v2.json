{
  "version": "poi-taxonomy/v2",
  "note": "Единственный источник правды по таксономии POI. Из него строятся проверки Intake, промпт классификатора, списки XLSX, переводы RU/EN и сверка опций Airtable. Коды неизменны; подписи меняются только вместе с версией и записью в labelHistory. Отличие v2 от v1: добавлен источник классификации rule — детерминированные правила портального классификатора не являются моделью, и помечать их model было ложным происхождением.",
  "dispositions": ["route", "exclude", "needs_review"],
  "catalogTargets": ["poi", "hotel", "restaurant", "event", "experience"],

  "languages": ["ru", "en"],
  "defaultLanguage": "ru",

  "routingVocabulary": {
    "note": "Служебные слова маршрутизации. Объявлены здесь, а не в коде, чтобы у loader'а не осталось собственных строк: перестановка или переименование должны быть правкой реестра, а не правкой модуля.",
    "wildcard": "any",
    "typeStateKnown": "known",
    "typeStateUnknown": "unknown",
    "classificationSources": ["rule", "model", "human"]
  },

  "entityKinds": [
    { "code": "tourist_poi", "labels": { "ru": "Туристический объект", "en": "Tourist POI" } },
    { "code": "accommodation", "labels": { "ru": "Размещение", "en": "Accommodation" } },
    { "code": "food_service", "labels": { "ru": "Общественное питание", "en": "Food Service" } },
    { "code": "event", "labels": { "ru": "Событие", "en": "Event" } },
    { "code": "experience", "labels": { "ru": "Впечатление с расписанием", "en": "Scheduled Experience" } },
    { "code": "transport_infrastructure", "labels": { "ru": "Транспортная инфраструктура", "en": "Transport Infrastructure" } },
    { "code": "retail_shop", "labels": { "ru": "Магазин", "en": "Retail Shop" } },
    { "code": "service_business", "labels": { "ru": "Коммерческая услуга", "en": "Service Business" } },
    { "code": "unknown", "labels": { "ru": "Не определено", "en": "Unknown" } }
  ],

  "excludeReasons": [
    { "code": "infrastructure_not_catalogued", "labels": { "ru": "Инфраструктура: каталога пока нет", "en": "Infrastructure: no catalogue yet" } },
    { "code": "not_a_destination", "labels": { "ru": "Не является точкой маршрута", "en": "Not a destination" } }
  ],

  "routingPolicy": [
    { "id": "poi_known_type", "entityKind": "tourist_poi", "typeState": "known", "classificationSource": "any",
      "disposition": "route", "catalogTarget": "poi",
      "why": "тип определён и входит в реестр — обычный путь" },
    { "id": "poi_type_unknown", "entityKind": "tourist_poi", "typeState": "unknown", "classificationSource": "any",
      "disposition": "needs_review", "catalogTarget": null,
      "why": "сущность туристическая, но чем именно является — не определено; догадка тут хуже остановки" },
    { "id": "poi_other_from_model", "entityKind": "tourist_poi", "typeState": "other_tourist_poi", "classificationSource": "model",
      "disposition": "needs_review", "catalogTarget": null,
      "why": "резервный тип от модели — это признание, что типа нет; автоимпорт с ним запрещён" },
    { "id": "poi_other_from_rule", "entityKind": "tourist_poi", "typeState": "other_tourist_poi", "classificationSource": "rule",
      "disposition": "needs_review", "catalogTarget": null,
      "why": "детерминированное правило не умеет обосновать резервный тип заметкой, поэтому решает человек" },
    { "id": "poi_other_from_human", "entityKind": "tourist_poi", "typeState": "other_tourist_poi", "classificationSource": "human",
      "disposition": "route", "catalogTarget": "poi", "requiresNote": true,
      "why": "человек посмотрел и решил завести, обязательно с заметкой" },
    { "id": "accommodation", "entityKind": "accommodation", "typeState": "any", "classificationSource": "any",
      "disposition": "route", "catalogTarget": "hotel", "why": "размещение живёт в своём каталоге" },
    { "id": "food_service", "entityKind": "food_service", "typeState": "any", "classificationSource": "any",
      "disposition": "route", "catalogTarget": "restaurant", "why": "рестораны живут в своём каталоге" },
    { "id": "event", "entityKind": "event", "typeState": "any", "classificationSource": "any",
      "disposition": "route", "catalogTarget": "event", "why": "события живут в своём каталоге" },
    { "id": "experience", "entityKind": "experience", "typeState": "any", "classificationSource": "any",
      "disposition": "route", "catalogTarget": "experience",
      "why": "услуга с поставщиком, расписанием и бронью" },
    { "id": "transport_infrastructure", "entityKind": "transport_infrastructure", "typeState": "any", "classificationSource": "any",
      "disposition": "exclude", "catalogTarget": null, "excludeReason": "infrastructure_not_catalogued",
      "why": "каталога инфраструктуры нет; появится потребитель — заведём отдельным ADR" },
    { "id": "retail_shop", "entityKind": "retail_shop", "typeState": "any", "classificationSource": "any",
      "disposition": "exclude", "catalogTarget": null, "excludeReason": "not_a_destination",
      "why": "обычный магазин точкой маршрута не является" },
    { "id": "service_business", "entityKind": "service_business", "typeState": "any", "classificationSource": "any",
      "disposition": "exclude", "catalogTarget": null, "excludeReason": "not_a_destination",
      "why": "коммерческая услуга без туристической ценности" },
    { "id": "unknown", "entityKind": "unknown", "typeState": "any", "classificationSource": "any",
      "disposition": "needs_review", "catalogTarget": null,
      "why": "сущность не опознана — решает человек" }
  ],

  "poiTypeGroups": [
    { "code": "religion", "labels": { "ru": "Религия", "en": "Religion" },
      "ambiguousHints": { "ru": ["храм"], "en": ["temple"] },
      "ambiguousHintNote": "«Храм» по-русски применяют и к синтоистскому святилищу. Термин уточняет ГРУППУ и никогда не назначает тип внутри неё." },
    { "code": "culture", "labels": { "ru": "Культура", "en": "Culture" } },
    { "code": "heritage", "labels": { "ru": "Наследие", "en": "Heritage" } },
    { "code": "nature", "labels": { "ru": "Природа", "en": "Nature" } },
    { "code": "urban", "labels": { "ru": "Город", "en": "Urban" } },
    { "code": "leisure", "labels": { "ru": "Досуг", "en": "Leisure" } },
    { "code": "bathing", "labels": { "ru": "Купание", "en": "Bathing" } },
    { "code": "fallback", "labels": { "ru": "Резерв", "en": "Fallback" } }
  ],

  "poiPrimaryTypes": [
    { "code": "shinto_shrine", "group": "religion", "autoImportAllowed": true,
      "labels": { "ru": "Синтоистское святилище", "en": "Shinto Shrine" },
      "hints": { "ru": ["святилище", "дзиндзя"], "en": ["shrine", "jinja"] },
      "include": ["действующее или музеефицированное синтоистское святилище"],
      "exclude": ["магазин или кафе, у которого святилище только в адресе"] },
    { "code": "buddhist_temple", "group": "religion", "autoImportAllowed": true,
      "labels": { "ru": "Буддийский храм", "en": "Buddhist Temple" },
      "hints": { "ru": ["буддийский храм", "тэра"], "en": ["buddhist temple", "tera", "ji"] },
      "include": ["действующий или музеефицированный буддийский храм"],
      "exclude": ["ресторан или магазин с названием храма в адресе", "синтоистское святилище"] },
    { "code": "religious_site_other", "group": "religion", "autoImportAllowed": true,
      "labels": { "ru": "Другой религиозный объект", "en": "Religious Site" },
      "include": ["церковь, мечеть, объект нового религиозного движения"],
      "exclude": ["синтоистское святилище", "буддийский храм"] },

    { "code": "museum", "group": "culture", "autoImportAllowed": true,
      "labels": { "ru": "Музей", "en": "Museum" },
      "hints": { "ru": ["музей"], "en": ["museum"] },
      "include": ["постоянная экспозиция с собственным фондом"],
      "exclude": ["временная выставка без своего помещения", "сувенирный магазин при музее"] },
    { "code": "art_venue", "group": "culture", "autoImportAllowed": true,
      "labels": { "ru": "Галерея / арт-пространство", "en": "Art Venue" },
      "hints": { "ru": ["галерея"], "en": ["gallery", "art"] },
      "include": ["галерея, арт-объект, художественная площадка"],
      "exclude": ["музей с постоянным фондом"] },
    { "code": "performing_arts_venue", "group": "culture", "autoImportAllowed": true,
      "labels": { "ru": "Театр / культурная площадка", "en": "Performing Arts Venue" },
      "hints": { "ru": ["театр"], "en": ["theatre", "theater"] },
      "include": ["театр, концертный зал, площадка традиционных искусств"],
      "exclude": ["кинотеатр", "разовое представление без своей площадки"] },

    { "code": "historic_site", "group": "heritage", "autoImportAllowed": true,
      "labels": { "ru": "Историческое место", "en": "Historic Site" },
      "include": ["место события, руины, исторический квартал"],
      "exclude": ["новодел без исторической связи"] },
    { "code": "architectural_landmark", "group": "heritage", "autoImportAllowed": true,
      "labels": { "ru": "Архитектурный объект", "en": "Architectural Landmark" },
      "include": ["здание, мост или башня, ценные архитектурой"],
      "exclude": ["обычное офисное здание"] },
    { "code": "castle_fortification", "group": "heritage", "autoImportAllowed": true,
      "labels": { "ru": "Замок / фортификация", "en": "Castle" },
      "hints": { "ru": ["замок"], "en": ["castle"] },
      "include": ["замок, крепость, руины укреплений"],
      "exclude": ["отель со словом «замок» в названии"] },
    { "code": "monument_public_art", "group": "heritage", "autoImportAllowed": true,
      "labels": { "ru": "Памятник / публичное искусство", "en": "Monument" },
      "include": ["памятник, мемориал, скульптура в городской среде"],
      "exclude": ["надгробие", "экспонат внутри музея"] },

    { "code": "park_garden", "group": "nature", "autoImportAllowed": true,
      "labels": { "ru": "Сад / парк", "en": "Park & Garden" },
      "hints": { "ru": ["сад", "парк"], "en": ["garden", "park"] },
      "include": ["ландшафтный сад, городской парк, ботанический сад"],
      "exclude": ["парк развлечений", "автостоянка со словом «парк»"] },
    { "code": "natural_landmark", "group": "nature", "autoImportAllowed": true,
      "labels": { "ru": "Природная достопримечательность", "en": "Natural Landmark" },
      "include": ["гора, водопад, ущелье, природный источник, пляж"],
      "exclude": ["благоустроенный городской парк"] },
    { "code": "viewpoint", "group": "nature", "autoImportAllowed": true,
      "labels": { "ru": "Смотровая точка", "en": "Viewpoint" },
      "hints": { "ru": ["смотровая"], "en": ["observation", "viewpoint"] },
      "include": ["смотровая площадка, обзорная точка, обзорный этаж башни"],
      "exclude": ["ресторан с видом", "здание целиком"] },

    { "code": "tourist_district", "group": "urban", "autoImportAllowed": true,
      "labels": { "ru": "Туристический район", "en": "Tourist District" },
      "include": ["оформленный квартал или улица, которые сами по себе точка маршрута"],
      "exclude": ["административный район без туристической функции"] },
    { "code": "market", "group": "urban", "autoImportAllowed": true,
      "labels": { "ru": "Рынок", "en": "Market" },
      "hints": { "ru": ["рынок"], "en": ["market"] },
      "include": ["продуктовый или оптовый рынок, открытый посетителям"],
      "exclude": ["супермаркет", "торговый центр"] },
    { "code": "shopping_street", "group": "urban", "autoImportAllowed": true,
      "labels": { "ru": "Торговая улица / квартал", "en": "Shopping Street" },
      "hints": { "ru": ["торговая улица"], "en": ["shopping street", "shotengai"] },
      "include": ["сётэнгай, крытая торговая галерея, торговый квартал"],
      "exclude": ["отдельный магазин", "улица, где торговля не основная функция"] },

    { "code": "amusement_park", "group": "leisure", "autoImportAllowed": true,
      "labels": { "ru": "Парк развлечений", "en": "Amusement Park" },
      "include": ["парк аттракционов, тематический парк"],
      "exclude": ["детская площадка", "игровой центр в торговом центре"] },
    { "code": "zoo_aquarium", "group": "leisure", "autoImportAllowed": true,
      "labels": { "ru": "Зоопарк / аквариум", "en": "Zoo & Aquarium" },
      "include": ["зоопарк, аквариум, океанариум, парк бабочек"],
      "exclude": ["зоомагазин", "контактный уголок внутри торгового центра"] },

    { "code": "public_onsen", "group": "bathing", "autoImportAllowed": true,
      "labels": { "ru": "Общественный онсэн / купальня", "en": "Public Onsen" },
      "hints": { "ru": ["онсэн", "сэнто"], "en": ["onsen", "sento"] },
      "include": ["общественная купальня, доступная без проживания"],
      "exclude": ["онсэн только для постояльцев рёкана", "коммерческий day spa"] },

    { "code": "other_tourist_poi", "group": "fallback", "autoImportAllowed": false,
      "labels": { "ru": "Прочий туристический объект", "en": "Other Tourist POI" },
      "include": ["объект туристической ценности, которому нет типа в реестре"],
      "exclude": ["всё, чему тип есть"],
      "note": "Только ручное решение с обязательной заметкой. Наберётся несколько однородных — заводим новый тип отдельной версией." }
  ],

  "facets": [
    { "code": "hot_spring", "labels": { "ru": "Природный источник", "en": "Hot Spring" } },
    { "code": "onsen", "labels": { "ru": "Есть онсэн", "en": "Has Onsen" } },
    { "code": "spa", "labels": { "ru": "Есть СПА", "en": "Has Spa" } },
    { "code": "night_view", "labels": { "ru": "Ночной вид", "en": "Night View" } }
  ],

  "badges": [
    { "code": "iconic_view", "labels": { "ru": "Знаковый вид", "en": "Iconic View" }, "assignedBy": "editor" },
    { "code": "jumbo_choice", "labels": { "ru": "Выбор Jumbo", "en": "Jumbo Choice" }, "assignedBy": "editor" },
    { "code": "seasonal_spot", "labels": { "ru": "Сезонное место", "en": "Seasonal Spot" }, "assignedBy": "editor" }
  ],

  "legacyCategoryMigrations": [
    { "value": "Ландшафтный сад", "mapsTo": "park_garden", "mode": "auto", "records": 7 },
    { "value": "Парк", "mapsTo": "park_garden", "mode": "auto", "records": 6 },
    { "value": "Историческая локация", "mapsTo": "historic_site", "mode": "auto", "records": 7 },
    { "value": "Городская достопримечательность", "mapsTo": null, "mode": "manual", "records": 3,
      "reason": "слишком расплывчато: под этим значением может быть район, мост, памятник или смотровая площадка" },
    { "value": "Знаковый вид", "mapsTo": null, "mode": "manual", "records": 16,
      "reason": "не тип, а бейдж; у пяти записей это единственная категория, тип назначается вручную" },
    { "value": "Ресторан", "mapsTo": null, "mode": "manual", "records": 1,
      "reason": "уходит в ресторанный каталог, а не в тип POI" },
    { "value": "Транспортный узел", "mapsTo": null, "mode": "manual", "records": 2,
      "reason": "инфраструктура; каталога нет, каждая запись разбирается отдельно" }
  ],

  "labelHistory": []
}
