# Переменные окружения jumboinjapan
#
# Скопировать в .env.local и заполнить нужное. Файл .env.local не коммитится.
# Публичные страницы собираются и работают БЕЗ единой переменной отсюда —
# на статическом контенте из src/data. Всё, что ниже, включает отдельные
# части: базу, админку, ботов, приём POI.
#
# Полноту этого списка стережёт `npm run check:docs`: он собирает имена из
# самого кода — прямые обращения к окружению, литеральные вызовы обёртки
# getEnv и поле envVar в реестре интеграций — и падает, если чего-то здесь
# нет. Даты «сверено на» тут больше нет намеренно: она устаревает молча, а
# проверка — нет. Единственное исключение из сверки — NODE_ENV: её задаёт
# платформа, а не этот файл.
#
# Значения секретов сюда не коммитятся никогда: этот файл — список имён.

# ── Airtable: основное хранилище ────────────────────────────────────────────
# Без них публичные страницы отдают собственный контент, админка не работает.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# ── Авторизация админки (/admin) ────────────────────────────────────────────
# Основной путь — вход через Google. Нужны все четыре, иначе isGoogleAdminAuthConfigured()
# считает вход ненастроенным. ADMIN_ALLOWED_EMAILS — список через запятую.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_AUTH_SECRET=
ADMIN_ALLOWED_EMAILS=

# Резервный вход по логину и паролю — только когда Google не настроен.
# Включается явным 'true'; пустые логин или пароль означают отказ.
# В проде держать выключенным.
ADMIN_BASIC_AUTH_FALLBACK=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# ── Telegram ────────────────────────────────────────────────────────────────
# Бот уведомлений о новых заявках с формы /contact.
TELEGRAM_BOT_TOKEN=
# Чат владельца. ОБЯЗАТЕЛЕН для бота приёма POI: без него вебхук не
# обрабатывает ничего (до 2026-08-09 отсутствие переменной, наоборот,
# пропускало любого пользователя бота — см. src/lib/telegram-owner-gate.ts).
TELEGRAM_OWNER_CHAT_ID=
# Отдельный бот приёма POI: фото таблички или пара строк → черновик в Airtable.
TELEGRAM_POI_BOT_TOKEN=
# Секрет вебхука, тот же, что задан в setWebhook. Без совпадения — 401.
TELEGRAM_WEBHOOK_SECRET=

# ── Модели ──────────────────────────────────────────────────────────────────
# Исследование места для черновика POI.
OPENAI_API_KEY=
OPENAI_MODEL=
# Альтернативные провайдеры в панели интеграций — опционально.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Google Places ───────────────────────────────────────────────────────────
# Координаты и place_id для POI: приём точки (src/lib/poi-intake.ts), разовая
# засыпка координат и ежемесячное обновление по place_id
# (scripts/backfill-coords-google.mjs, scripts/refresh-google-coords.mjs),
# плюс карточка в панели интеграций. Без ключа эти пути координат не получают
# и сообщают об этом; остальной сайт работает.
GOOGLE_PLACES_API_KEY=

# ── Формы и антиспам ────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Прочее ──────────────────────────────────────────────────────────────────
# Секрет ручной инвалидации кеша: POST /api/revalidate.
REVALIDATE_SECRET=
# Секрет панели интеграций.
INTEGRATIONS_SECRET=
# Google Analytics на публичных страницах.
NEXT_PUBLIC_GA_ID=
# Разрешает разовый сид устаревших услуг. По умолчанию выключено.
ALLOW_DEPRECATED_SERVICES_SEED=
# Секрет cron-маршрута обновления координат: POST /api/cron/refresh-coords.
# Vercel подписывает вызов заголовком с этим значением. Без переменной маршрут
# отвечает 503 и координаты по place_id не обновляются — а срок хранения
# содержимого Google Maps Platform идёт всё равно.
CRON_SECRET=
