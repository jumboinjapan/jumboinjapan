# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tgz

# Локальные настройки инструментов: внутри абсолютные пути вида
# /Users/<кто-то>/… — на другой машине они бессмысленны.
.claude/settings.local.json
.claude/launch.json
.codex/
.cursor/
.impeccable/

# Выгрузки и резервные копии данных — тяжёлые и быстро протухают.
backup/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenClaw workspace files
#
# 17 мая 2026 (0621f0c4) сюда за компанию с рабочими файлами агента попали
# scripts/, skills/ и AGENTS.md. Из-за scripts/ 17 файлов из 35 не уехали на
# GitHub, и десять команд package.json падали на чистом клоне с
# MODULE_NOT_FOUND, а из-за AGENTS.md у агентов не было общей точки входа.
# Правило: сюда попадает только то, что агент пишет для себя. Всё, на что
# ссылается package.json или документация, обязано быть в репозитории.
.openclaw/
SOUL.md
TOOLS.md
HEARTBEAT.md
IDENTITY.md
USER.md
DREAMS.md
memory/
tmp/
tmp-*/

# Артефакты Workflow SDK: пакет удалён 2026-08-09, но сгенерированные им
# роуты могли остаться в рабочих копиях — под src/app они стали бы живыми
# путями. Удалить у себя: rm -rf src/app/.well-known/workflow
src/app/.well-known/workflow/
